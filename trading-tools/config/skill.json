{
  "name": "trading-review-assistant",
  "description": "交易复盘助手 - 自动获取市场数据、解析交易记录、生成复盘报告",
  "version": "1.0.0",
  "author": "Edge51",
  "tools": [
    {
      "name": "fetch_market_data",
      "description": "获取市场数据（上证指数、活跃市值、涨跌停等）",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "日期 (YYYY-MM-DD格式)，默认为今天"
          },
          "sources": {
            "type": "array",
            "items": {"type": "string"},
            "description": "数据源列表: compass, eastmoney, sina"
          }
        }
      }
    },
    {
      "name": "fetch_stock_data",
      "description": "获取个股数据（日线、分时、成交等）",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "股票代码 (如 600312)"
          },
          "market": {
            "type": "string",
            "enum": ["sh", "sz"],
            "description": "市场 (sh上证/sz深证)"
          },
          "data_type": {
            "type": "string",
            "enum": ["day", "minute1", "minute5", "realtime"],
            "description": "数据类型"
          }
        }
      }
    },
    {
      "name": "parse_trade_records",
      "description": "解析交易记录文本，提取交易信息",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "交易记录文本（Markdown表格格式）"
          }
        }
      }
    },
    {
      "name": "generate_review_report",
      "description": "生成复盘报告",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "复盘日期"
          },
          "market_data": {
            "type": "object",
            "description": "市场数据对象"
          },
          "trades": {
            "type": "array",
            "description": "交易记录列表"
          },
          "pre_plan": {
            "type": "object",
            "description": "盘前计划"
          }
        }
      }
    },
    {
      "name": "get_active_market_value",
      "description": "获取指南针平台的活跃市值数据",
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "日期 (YYYY-MM-DD)"
          }
        }
      }
    }
  ],
  "workflows": [
    {
      "name": "daily_review",
      "description": "生成每日复盘报告的完整流程",
      "steps": [
        {"action": "fetch_market_data", "description": "获取今日市场数据"},
        {"action": "prompt_user_trades", "description": "请用户输入交易记录"},
        {"action": "parse_trade_records", "description": "解析交易记录"},
        {"action": "fetch_stock_data", "description": "获取相关个股数据"},
        {"action": "generate_review_report", "description": "生成复盘报告"}
      ]
    },
    {
      "name": "pre_market_analysis",
      "description": "盘前分析流程",
      "steps": [
        {"action": "fetch_market_data", "description": "获取昨日市场数据"},
        {"action": "get_active_market_value", "description": "获取活跃市值"},
        {"action": "fetch_stock_data", "description": "获取关注个股数据"}
      ]
    }
  ],
  "config": {
    "tdx_data_path": "C:/TdxW/data",
    "compass_api_url": "",
    "compass_api_key": "",
    "output_format": "markdown",
    "auto_save": true
  }
}